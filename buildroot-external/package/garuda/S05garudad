#!/bin/sh
#
# 9xOS Garuda liveness monitor. Starts early so that applications
# started later can register with it.

DAEMON="garudad"
PIDFILE="/var/run/$DAEMON.pid"
GARUDA_WATCHDOG=""

# shellcheck source=/dev/null
[ -r "/etc/default/$DAEMON" ] && . "/etc/default/$DAEMON"

start() {
	printf 'Starting %s: ' "$DAEMON"
	if [ -n "$GARUDA_WATCHDOG" ]; then
		set -- -w "$GARUDA_WATCHDOG"
	else
		set --
	fi
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "/usr/sbin/$DAEMON" -- "$@"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"
	start-stop-daemon -K -q -p "$PIDFILE"
	status=$?
	if [ "$status" -eq 0 ]; then
		rm -f "$PIDFILE"
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

case "$1" in
	start|stop)
		"$1";;
	restart|reload)
		stop
		sleep 1
		start;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
